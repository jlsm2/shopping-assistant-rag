# Copy to .env (git-ignored) and fill in. The app reads .env from the current
# directory; a variable already set in the environment wins over this file.

# --- LLM: everything is configuration, nothing is built in -------------------
# Which kind of API: "anthropic" or "openai". "openai" means any API that speaks
# the OpenAI Chat Completions format, including local servers.
LLM_PROVIDER=
# The model id, exactly as that provider names it.
LLM_MODEL=
# The provider's key. For a local server that needs none, write: local
LLM_API_KEY=
# Only for "openai"-compatible services other than OpenAI itself. Check the
# provider's documentation for the current address. Common ones:
#   Google Gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq            https://api.groq.com/openai/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   Ollama (local)  http://localhost:11434/v1
#   LM Studio       http://localhost:1234/v1
LLM_BASE_URL=
# Reasoning effort, if the model has it (for example: low, medium, high). Empty: not sent.
LLM_EFFORT=
# Output tokens per call, reasoning included.
LLM_MAX_TOKENS=4096
# Anthropic only: when the model declines for a safety filter, the API re-runs
# the call on the fallback model it recommends.
LLM_REFUSAL_FALLBACK=true
# "openai" only. Some APIs (Groq) reject tools and a JSON schema in the same
# request; false sends them in separate calls.
LLM_SCHEMA_WITH_TOOLS=true

# --- access ------------------------------------------------------------------
# Required. Shared secret that the store backend sends as "Authorization: Bearer <token>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma-separated; keep two only while rotating.
SERVICE_TOKENS=

# --- limits ------------------------------------------------------------------
# Spend ceiling: LLM tokens (input + output) per UTC day. When it is spent,
# every question gets the fixed fallback until midnight UTC.
DAILY_TOKEN_BUDGET=2000000
# Seconds allowed for one question, tool rounds included.
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20

# --- retrieval and server ------------------------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0
MAX_TOOL_ITERATIONS=4
CORS_ORIGINS=http://localhost:3000
# DATA_DIR=./data
