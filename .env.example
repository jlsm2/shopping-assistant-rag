# Copy to .env (git-ignored) and fill in. The app reads .env from the current
# directory; a variable already set in the environment wins over this file.

# Required. Key of the LLM provider: console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Required. Shared secret that the store backend sends as "Authorization: Bearer <token>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma-separated; keep two only while rotating.
SERVICE_TOKENS=

# Which model answers. Any Anthropic model id, e.g. claude-sonnet-5-5 or claude-haiku-5-5.
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Leave empty to not send it.
ASSISTANT_EFFORT=low
# Output tokens per call, reasoning included.
ASSISTANT_MAX_TOKENS=4096
# Re-run a safety decline on the fallback model Anthropic recommends.
ASSISTANT_SERVER_FALLBACK=true

# Spend ceiling: LLM tokens (input + output) per UTC day. When it is spent,
# every question gets the fixed fallback until midnight UTC.
DAILY_TOKEN_BUDGET=2000000
# Seconds allowed for one question, tool rounds included.
LLM_TIMEOUT_SECONDS=30

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0
MAX_TOOL_ITERATIONS=4
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
# DATA_DIR=./data
