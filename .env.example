# LLM provider: not chosen yet. When it is, add its credentials here and
# return the adapter from app/api.py:build_llm(). Never commit real keys.

# Required. Shared secret that the store backend sends as "Authorization: Bearer <token>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Comma-separated; keep two only while rotating.
SERVICE_TOKENS=

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0
MAX_TOOL_ITERATIONS=4
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
# DATA_DIR=./data
